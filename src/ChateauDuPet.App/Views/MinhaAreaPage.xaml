<?xml version="1.0" encoding="utf-8" ?>
<v:PaginaBase
    x:Class="ChateauDuPet.App.Views.MinhaAreaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:ChateauDuPet.Contracts;assembly=ChateauDuPet.Contracts"
    xmlns:comp="clr-namespace:ChateauDuPet.App.Views.Componentes"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:v="clr-namespace:ChateauDuPet.App.Views"
    xmlns:vm="clr-namespace:ChateauDuPet.App.Core.ViewModels;assembly=ChateauDuPet.App.Core"
    Title="Minha área"
    x:DataType="vm:MinhaAreaViewModel"
    Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Visitante: convite para entrar -->
        <VerticalStackLayout
            Padding="32"
            IsVisible="{Binding EhVisitante}"
            MaximumWidthRequest="{StaticResource LarguraMaxima}"
            Spacing="16"
            VerticalOptions="Center">
            <Image HeightRequest="180" Source="ilustra_curriculo.png" />
            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource Titulo}"
                Text="Sua carreira no mundo pet" />
            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource Legenda}"
                Text="Entre para acompanhar suas candidaturas e ver seu currículo. Empresas publicam e gerenciam vagas aqui, e administradores cuidam do cadastro." />
            <Button Command="{Binding EntrarCommand}" Text="Entrar" />
        </VerticalStackLayout>

        <RefreshView
            Command="{Binding AtualizarCommand}"
            IsRefreshing="{Binding Atualizando}"
            IsVisible="{Binding EhVisitante, Converter={StaticResource Inverter}}">
            <ScrollView>
                <VerticalStackLayout
                    Padding="16,16,16,24"
                    MaximumWidthRequest="{StaticResource LarguraMaxima}"
                    Spacing="16">

                    <!-- Cabeçalho com o usuário logado -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Style="{StaticResource Avatar}" WidthRequest="56" HeightRequest="56">
                            <Label Style="{StaticResource AvatarTexto}" Text="{Binding Iniciais}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Style="{StaticResource TituloCard}" Text="{Binding Usuario.Nome}" />
                            <Label Style="{StaticResource Legenda}" Text="{Binding Usuario.Email}" />
                        </VerticalStackLayout>
                        <ImageButton
                            Grid.Column="2"
                            Padding="10"
                            Command="{Binding SairCommand}"
                            HeightRequest="44"
                            SemanticProperties.Description="Sair da conta"
                            Source="ic_box_arrow_right.png"
                            WidthRequest="44" />
                    </Grid>

                    <!-- Erro ou carregamento do conteúdo da conta -->
                    <comp:EstadoDaTela HeightRequest="280" IsVisible="{Binding MostrarConteudo, Converter={StaticResource Inverter}}" />

                    <!-- Profissional: candidaturas -->
                    <VerticalStackLayout IsVisible="{Binding MostrarConteudo}" Spacing="16">
                        <VerticalStackLayout IsVisible="{Binding EhProfissional}" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource Secao}" Text="Minhas candidaturas" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource Legenda}"
                                    Text="{Binding ResumoCandidaturas}"
                                    VerticalOptions="End" />
                            </Grid>
                            <Border IsVisible="{Binding Candidaturas, Converter={StaticResource ListaVazia}}" Style="{StaticResource Card}">
                                <Label
                                    HorizontalTextAlignment="Center"
                                    Style="{StaticResource Legenda}"
                                    Text="Você ainda não se candidatou. Encontre uma vaga na aba Vagas!" />
                            </Border>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Candidaturas}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="c:CandidaturaResumo">
                                        <Border Style="{StaticResource Card}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding AbrirCandidaturaCommand, Source={RelativeSource AncestorType={x:Type vm:MinhaAreaViewModel}}, x:DataType=vm:MinhaAreaViewModel}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label FontFamily="OpenSansSemibold" Text="{Binding Vaga}" />
                                                    <Label Style="{StaticResource Legenda}" Text="{Binding Empresa}" />
                                                </VerticalStackLayout>
                                                <Label
                                                    Grid.Column="1"
                                                    Style="{StaticResource Legenda}"
                                                    Text="{Binding Data, Converter={StaticResource TempoRelativo}}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Profissional: currículo -->
                        <VerticalStackLayout IsVisible="{Binding Perfil, Converter={StaticResource NaoNulo}}" Spacing="10">
                            <Label Style="{StaticResource Secao}" Text="Meu currículo" />
                            <comp:CurriculoView BindingContext="{Binding Perfil}" />
                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource Legenda}"
                                Text="Para editar o currículo, use o portal web." />
                        </VerticalStackLayout>

                        <!-- Empresa: gestão das vagas publicadas -->
                        <VerticalStackLayout IsVisible="{Binding EhEmpresa}" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout VerticalOptions="End">
                                    <Label Style="{StaticResource Secao}" Text="Vagas publicadas" />
                                    <Label Style="{StaticResource Legenda}" Text="{Binding ResumoVagas}" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding PublicarVagaCommand}"
                                    Style="{StaticResource BotaoPequeno}"
                                    Text="+ Publicar vaga"
                                    VerticalOptions="End" />
                            </Grid>
                            <Border IsVisible="{Binding MinhasVagas, Converter={StaticResource ListaVazia}}" Style="{StaticResource Card}">
                                <Label
                                    HorizontalTextAlignment="Center"
                                    Style="{StaticResource Legenda}"
                                    Text="Nenhuma vaga publicada ainda. Toque em &quot;Publicar vaga&quot; para começar." />
                            </Border>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding MinhasVagas}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="c:VagaResumo">
                                        <Border Style="{StaticResource Card}">
                                            <Grid
                                                ColumnDefinitions="*,Auto"
                                                ColumnSpacing="8"
                                                RowDefinitions="Auto,Auto"
                                                RowSpacing="12">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label FontFamily="OpenSansSemibold" Text="{Binding Titulo}" />
                                                    <Label Style="{StaticResource Legenda}" Text="{Binding PublicadaEm, Converter={StaticResource TempoRelativo}, StringFormat='Publicada {0}'}" />
                                                </VerticalStackLayout>
                                                <Border
                                                    Grid.Column="1"
                                                    Style="{StaticResource Chip}"
                                                    VerticalOptions="Center">
                                                    <HorizontalStackLayout Spacing="4">
                                                        <Image
                                                            HeightRequest="12"
                                                            Source="ic_people.png"
                                                            WidthRequest="12" />
                                                        <Label Style="{StaticResource ChipTexto}" Text="{Binding TotalCandidatos}" />
                                                    </HorizontalStackLayout>
                                                </Border>
                                                <HorizontalStackLayout
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Spacing="8">
                                                    <Button
                                                        Command="{Binding AbrirCandidatosCommand, Source={RelativeSource AncestorType={x:Type vm:MinhaAreaViewModel}}, x:DataType=vm:MinhaAreaViewModel}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource BotaoPequeno}"
                                                        Text="Ver candidatos" />
                                                    <Button
                                                        Command="{Binding EditarVagaCommand, Source={RelativeSource AncestorType={x:Type vm:MinhaAreaViewModel}}, x:DataType=vm:MinhaAreaViewModel}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource BotaoPequenoSecundario}"
                                                        Text="Editar" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Administrador: atalho para o painel -->
                        <Border IsVisible="{Binding EhAdministrador}" Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="12">
                                <Label Style="{StaticResource TituloCard}" Text="Administração" />
                                <Label Style="{StaticResource Legenda}" Text="Gerencie profissionais, empresas e vagas: busque, veja currículos e exclua cadastros." />
                                <Button Command="{Binding AbrirAdministracaoCommand}" Text="Abrir painel de administração" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</v:PaginaBase>
