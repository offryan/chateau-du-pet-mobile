<?xml version="1.0" encoding="utf-8" ?>
<!-- Currículo de um profissional (dados, experiências e certificados). Usado na "Minha área"
     do profissional e na tela de currículo que empresas e administradores abrem. -->
<ContentView
    x:Class="ChateauDuPet.App.Views.Componentes.CurriculoView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:ChateauDuPet.Contracts;assembly=ChateauDuPet.Contracts"
    x:DataType="c:PerfilProfissional">
    <VerticalStackLayout Spacing="10">
        <Border Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="10">
                <Label
                    IsVisible="{Binding Biografia, Converter={StaticResource TemTexto}}"
                    LineHeight="1.3"
                    Text="{Binding Biografia}" />
                <HorizontalStackLayout IsVisible="{Binding Formacao, Converter={StaticResource TemTexto}}" Spacing="8">
                    <Image Source="ic_mortarboard.png" Style="{StaticResource Icone}" />
                    <Label Text="{Binding Formacao}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <Image Source="ic_envelope.png" Style="{StaticResource Icone}" />
                    <Label Text="{Binding Email}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <Image Source="ic_telephone.png" Style="{StaticResource Icone}" />
                    <Label Text="{Binding Telefone, Converter={StaticResource Telefone}}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout IsVisible="{Binding Cidade, Converter={StaticResource TemTexto}}" Spacing="8">
                    <Image Source="ic_geo_alt.png" Style="{StaticResource Icone}" />
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Cidade}" />
                                <Span Text=" - " />
                                <Span Text="{Binding UF}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Label
            IsVisible="{Binding Experiencias, Converter={StaticResource ListaComItens}}"
            Style="{StaticResource Rotulo}"
            Text="Experiências" />
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Experiencias}" Spacing="10">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="c:ExperienciaInfo">
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Image
                                Source="ic_briefcase.png"
                                Style="{StaticResource Icone}"
                                VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label FontFamily="OpenSansSemibold" Text="{Binding Cargo}" />
                                <Label Text="{Binding Empresa}" />
                                <Label Style="{StaticResource Legenda}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding ., Converter={StaticResource Periodo}}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding TipoContrato}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <Label
            IsVisible="{Binding Certificados, Converter={StaticResource ListaComItens}}"
            Style="{StaticResource Rotulo}"
            Text="Formação e certificados" />
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Certificados}" Spacing="10">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="c:CertificadoInfo">
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Image
                                Source="ic_award.png"
                                Style="{StaticResource Icone}"
                                VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label FontFamily="OpenSansSemibold" Text="{Binding Curso}" />
                                <Label Text="{Binding Instituicao}" />
                                <Label Style="{StaticResource Legenda}" Text="{Binding ., Converter={StaticResource Periodo}}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
